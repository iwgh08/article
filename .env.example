# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 요약 방식: claude-code (Claude 구독 사용, 기본값) / api (API 크레딧 사용)
SUMMARIZER=claude-code
# SUMMARIZER=api 일 때만 필요
ANTHROPIC_API_KEY=
# 요약에 쓸 모델 (claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5)
CLAUDE_MODEL=claude-opus-5-5

# 보내는 Gmail 계정과 앱 비밀번호(16자리, 공백 없이)
GMAIL_ADDRESS=your.address@gmail.com
GMAIL_APP_PASSWORD=
# 받는 주소 (여러 개는 쉼표로 구분)
MAIL_TO=your.address@gmail.com
